# Database (Neon Serverless PostgreSQL connection URL)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# Server Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:5174

# Authentication (JWT signing secret - minimum 32 characters)
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-chars

# AI Provider (Google Gemini system fallback)
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash-lite

# BYOK Application-Level Encryption (AES-256-GCM secret key)
AI_KEY_ENCRYPTION_SECRET=your-32-byte-hex-encryption-secret-here

